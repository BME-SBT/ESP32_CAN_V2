%--------------------------------------------------------------------------------------
% Oldal layout
%--------------------------------------------------------------------------------------
% we need to redefine the pagestyle plain
% another possibility is to use the body of this command without \fancypagestyle
% and use \pagestyle{fancy} but in that case the special pages
% (like the ToC, the References, and the Chapter pages)remain in plane style




\setcounter{tocdepth}{3}
\setcounter{secnumdepth}{3}
\pagenumbering{arabic}  

%% Margók és lapelrendezés------------------------------------------------------------
\makeatletter
\if@twoside%
\geometry{inner=30mm, outer=20mm, top=5mm, bottom=30mm, includeheadfoot}
\else%
\geometry{inner=20mm, outer=20mm, top=5mm, bottom=30mm, includeheadfoot}
\fi%  
\makeatother

%% fejléc és lábléc--------------------------------------------------------------------
\pagestyle{fancy}
\fancyhf{} % clear all footer fields
\setlength\headheight{54pt} % resolve header warning
\fancyhead[RO,LE]{\includegraphics[height=1.5cm]{includes/BME-SolarBoat-logo}}
\fancyhead[RE,LO]{\title\ -- \the\year{}}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}

\makeatletter
\if@twoside%
\fancyfoot[LE,RO]{\thepage}
\else%
\fancyfoot[C]{\thepage}
\fi%  
\makeatother

