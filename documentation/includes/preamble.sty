% ==================== CODE HIGHLIGHTING ====================
\RequirePackage{listings}            % Code listing support
\RequirePackage{xcolor}              % Color support for code
\definecolor{lightgray}{rgb}{0.95,0.95,0.95}
\RequirePackage{listingsutf8}

% Define C code environment with syntax highlighting
\lstdefinestyle{cstyle}{
	language=C,
	basicstyle=\ttfamily\small,
	keywordstyle=\color{blue}\bfseries,
	commentstyle=\color{green!60!black}\itshape,
	stringstyle=\color{red},
	numberstyle=\footnotesize\color{gray},
	numbers=left,
	numbersep=8pt,
	breaklines=true,
	breakatwhitespace=true,
	tabsize=3,
	showstringspaces=false,
	captionpos=b,
	showstringspaces=false, % no special string spaces
	aboveskip=3pt,
	belowskip=3pt,
	backgroundcolor=\color{lightgray},
	columns=flexible,
	keepspaces=true,
	escapeinside={(*@}{@*)},
	frame=single,
	float=!ht,
	literate=*
	{á}{{\'a}}1	{é}{{\'e}}1	{í}{{\'i}}1	{ó}{{\'o}}1	{ö}{{\"o}}1	{ő}{{\H{o}}}1	{ú}{{\'u}}1	{ü}{{\"u}}1	{ű}{{\H{u}}}1
	{Á}{{\'A}}1	{É}{{\'E}}1	{Í}{{\'I}}1	{Ó}{{\'O}}1	{Ö}{{\"O}}1	{Ő}{{\H{O}}}1	{Ú}{{\'U}}1	{Ü}{{\"U}}1	{Ű}{{\H{U}}}1,
	extendedchars=true,     % ← fontos!
	inputencoding=utf8
}

% Create custom environment for C code
\lstnewenvironment{ccode}[1][]{
	\lstset{style=cstyle, #1}
}{}

